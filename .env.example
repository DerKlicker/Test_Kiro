# Optionale Vorbelegung der Eingabemaske.
# Kopiere diese Datei zu ".env" und trage deine Werte ein, wenn du die
# Felder nicht jedes Mal von Hand eingeben möchtest. Die .env wird NICHT
# eingecheckt (siehe .gitignore).
#
# Alle Werte sind optional – du kannst sie auch direkt in der Weboberfläche eingeben.

NOTION_TOKEN=
NOTION_DATABASE_ID=
BRING_EMAIL=
BRING_LIST=

# --- Netzwerk / SSL (nur im Firmennetz nötig) ---
# Pfad zum Firmen-Root-Zertifikat (.pem/.crt), falls HTTPS über einen Proxy läuft.
CA_CERT_PATH=
# Auf "true" setzen, um die SSL-Prüfung zu deaktivieren (unsicher, nur im
# vertrauenswürdigen Firmennetz verwenden).
DISABLE_SSL_VERIFY=
