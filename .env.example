# Zentrale Zugangsdaten (empfohlen für den Dauerbetrieb / Docker).
#
# Sind diese gesetzt, überträgt die Startseite beim Aufruf automatisch und der
# /run-Endpunkt (z.B. für einen Notion-Button) funktioniert ohne Eingabe.
# Fehlende Werte können weiterhin über das Formular der Weboberfläche ergänzt
# oder überschrieben werden.
#
# Kopiere diese Datei zu ".env" und trage deine Werte ein. Die .env wird NICHT
# eingecheckt (siehe .gitignore).

NOTION_TOKEN=
NOTION_DATABASE_ID=
BRING_EMAIL=
BRING_PASSWORD=
# Optional: bestimmte Bring!-Liste (leer = erste/Standardliste)
BRING_LIST=

# --- Netzwerk / SSL (nur im Firmennetz nötig) ---
# Pfad zum Firmen-Root-Zertifikat (.pem/.crt), falls HTTPS über einen Proxy läuft.
CA_CERT_PATH=
# Auf "true" setzen, um die SSL-Prüfung zu deaktivieren (unsicher, nur im
# vertrauenswürdigen Firmennetz verwenden).
DISABLE_SSL_VERIFY=
